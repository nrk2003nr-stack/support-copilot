DATABASE_URL=sqlite:///./support.db
SECRET_KEY=change-this-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEED_DEMO_DATA=true

# Optional AI providers. The app runs locally without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
ENABLE_TRANSFORMERS_SENTIMENT=false

# Storage
CHROMA_PATH=./chroma_db

# Channels default to mock mode unless enabled.
SLACK_ENABLED=false
SLACK_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_SECRET=
EMAIL_ENABLED=false
EMAIL_WEBHOOK_SECRET=
HUBSPOT_ENABLED=false
HUBSPOT_API_KEY=
SALESFORCE_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_WIDGET_URL=http://localhost:3000
